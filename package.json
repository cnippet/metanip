{
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "name": "metanip",
  "packageManager": "bun@1.3.7",
  "patchedDependencies": {
    "kysely@0.29.2": "patches/kysely@0.29.2.patch"
  },
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "format:all": "biome check --write --unsafe --no-errors-on-unmatched",
    "lint": "turbo run lint"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
